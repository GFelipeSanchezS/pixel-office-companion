config_version=5

[application]
config/name="Pixel Office Companion"
run/main_scene="res://src/main.tscn"

[display]
window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
